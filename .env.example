# ============================================================
# Aero Bound Ventures - Environment Variables
# ============================================================
# Generated so `docker compose up --build` works immediately from a
# fresh clone. These are real, usable values for LOCAL DEVELOPMENT
# ONLY -- rotate SECRET_KEY, GUARD_API_KEY, and every *_PASSWORD below
# before deploying anywhere real. The Amadeus/Pesapal/Cloudinary/
# Google/Gemini/SMTP values below are placeholders carried over from
# backend/.env.example; those integrations stay inert (their routes
# return "not configured"/fail gracefully) until you supply real
# credentials -- nothing else depends on them.
# ============================================================

ENVIRONMENT=development

# ------------------------------------------------------------
# Core app
# ------------------------------------------------------------
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# Database (PostgreSQL) -- must stay consistent with the db
# service's POSTGRES_USER/PASSWORD/DB in docker-compose.yml
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Redis Commander UI (visualize Redis keys): http://localhost:8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# ------------------------------------------------------------
# Kafka
# ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ------------------------------------------------------------
# Flights
# ------------------------------------------------------------
# "mock" serves fixtures from external_services/mock_data/ -- no real
# Amadeus account needed to run the app end-to-end. Switch to
# "amadeus" and fill in the keys below once you have one.
FLIGHT_SERVICE_PROVIDER=mock
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=test.api.amadeus.com

# ------------------------------------------------------------
# Pesapal payment gateway (sandbox placeholders -- see
# https://www.pesapal.com/dashboard for real credentials)
# ------------------------------------------------------------
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_IPN_ID=

# ------------------------------------------------------------
# Cloudinary (ticket file storage) -- placeholder, uploads will fail
# until you supply a real cloudinary:// URL
# ------------------------------------------------------------
CLOUDINARY_URL=

# ------------------------------------------------------------
# Google OAuth -- left blank; the app detects this and disables the
# Google login route rather than failing
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ------------------------------------------------------------
# Gemini AI (placeholder)
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# SMTP (placeholder -- also used by Grafana for alert emails below).
# Outgoing mail will fail until you supply real credentials; this
# doesn't block anything else from working.
# ------------------------------------------------------------
MAIL_USERNAME=john@gmail.com
MAIL_PASSWORD=
MAIL_FROM=example@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ------------------------------------------------------------
# FastAPI Guard (rate limiting / bot & abuse detection middleware)
# ------------------------------------------------------------

GUARD_API_KEY=
# The real guard-core.com SaaS agent is disabled by default for local
# dev, since GUARD_API_KEY above isn't a real account key.

ENABLE_GUARD_AGENT=false
RATE_LIMIT=100
RATE_LIMIT_WINDOW=60
ENABLE_REDIS=true
BLOCKED_USER_AGENTS=curl,wget
AUTO_BAN_THRESHOLD=5
AUTO_BAN_DURATION=86400
ENABLE_PENETRATION_DETECTION=true
PASSIVE_MODE=true
GUARD_FAIL_SECURE=true

# ------------------------------------------------------------
# Frontend (Next.js) -- NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time (see frontend/Dockerfile's build args)
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SHOW_TEST_DATA=false

# ------------------------------------------------------------
# OpenTelemetry (shared defaults; OTEL_SERVICE_NAME is set per
# service in docker-compose.yml since three processes share these
# values)
# ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ------------------------------------------------------------
# Ports published to the host
# ------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT_HOST=6379
REDIS_COMMANDER_PORT=8081
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200

# ------------------------------------------------------------
# Grafana
# ------------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
# Where CPU/memory > 70% alert emails are sent (see
# observability/grafana/provisioning/alerting/contact-points.yaml).
# Delivery depends on the SMTP settings above being real.
ALERT_EMAIL_TO=admin@example.com
